{
  "config": {
    "MD013": false
  },
  "ignores": [
    "node_modules/**",
    ".browser-cache/**",
    ".worktrees/**",
    "**/dist/**",
    "test-results/**",
    "playwright-report/**",
    "coverage/**"
  ],
  "overrides": [
    {
      "filter": ["AGENTS.md"],
      "config": {
        "MD041": false
      },
      "combine": "merge"
    }
  ]
}
